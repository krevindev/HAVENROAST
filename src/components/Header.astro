---
const mainLogo = "/assets/logos/main-logo.svg";
---

<div class="bg-primary sticky top-0 left-0 flex justify-between px-4 py-6">
  <!-- Logo -->
  <div>
    <img src={mainLogo} />
  </div>

  <!-- Navigation -->
  <div class="">
    <ul class="flex gap-4 text-accent">
      <li>Home</li>
      <li>Store</li>
      <li>About</li>
      <button class="bg-accent text-primary px-4 py-1 rounded-sm">Contact</button>
    </ul>
  </div>

  <div class="absolute h-[1px] bottom-0 dashed-gradient-bottom w-full"/>
</div>
