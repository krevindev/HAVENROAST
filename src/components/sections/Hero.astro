---
import ArrowRight from "phosphor-astro/ArrowRight.astro";
---

<div class="bg-primary min-h-[85svh] px-10 flex flex-col justify-evenly items-center">
  <!-- Container Main -->
  <div class="h-[70%] w-full grid grid-cols-2">
    <!-- Text Segment -->
    <div class="flex flex-col gap-2 justify-center items-start p-10">
      <div class="flex flex-col justify-start items-start text-secondary font-extrabold text-8xl tracking-tighter leading-[80px] mb-3">
        <h1>
          <span class="text-nowrap">Cup in Hand,</span> Anywhere
        </h1>
      </div>
      <p class="text-2xl tracking-wide text-accent font-light">
        Your daily cup, ready when you are.
      </p>

      <button class="bg-custom-orange hover:bg-custom-orange/90 transition cursor-pointer px-6 py-2 mt-5 text-lg rounded-sm text-primary">
        Order Now
      </button>
    </div>

    <!-- Image Segment -->
    <div class="flex justify-center items-center p-10 relative">
      <!-- outer container -->
      <div class="flex w-full h-full justify-center items-center relative">
        <!-- <h1
          class="absolute text-9xl translate-x-[10%] font-semibold text-secondary/10 overflow-hidden"
        >
          CAPPUCCINOS
        </h1> -->
        <div class="relative">
          <!-- Image -->
          <img
            id="hero-image"
            class="rotate-30 w-[300px]"
            src="/assets/images/hero/hero-image-1.svg"
          />
          <!-- Shadow -->
          <div>
            <div class="absolute bg-[#4d4d4d] rounded-full w-[70%] h-5 blur-xl bottom-0 left-1/2 -translate-x-1/2"></div>
          </div>
        </div>

        <div class="absolute right-0 bottom-0 flex justify-center items-center gap-2">
          <span class="text-accent font-thin">1/4</span>
          <button class="rounded-full p-3 bg-accent/10 flex justify-center items-center gap-1">
            <ArrowRight height={20} class="text-accent" />
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Hero Details Container -->
  <div class="w-full text-accent h-[30%] grid grid-cols-3">
    <!-- Detail 1 -->
    <div class="dashed-gradient-right flex flex-col items-center justify-center gap-2 text-sm font-light">
      <div class="flex w-64 items-center justify-start gap-3">
        <img class="size-5" src="/assets/icons/location-icon.svg" />
        <p>123 Brew Street, Cityville</p>
      </div>

      <div class="flex w-64 items-center justify-start gap-3">
        <img class="size-5" src="/assets/icons/calendar-icon.svg" />
        <p>Mon–Sun: 7 AM – 8 PM</p>
      </div>
    </div>

    <!-- Detail 2 -->
    <div class="flex flex-col justify-center items-center text-center">
      <h2 class="text-secondary font-semibold">Our Drinks</h2>
      <p class="text-sm font-light">
        Iced coffees, lattes, cold brews,
        <br /> and seasonal specials
      </p>
    </div>
    <!-- Detail 3 -->
    <div class="dashed-gradient-left flex justify-center items-center">
      <div class="font-light text-sm">
        <p>(555) 123-4567</p>
        <p>www.timpla.ph/store</p>
      </div>
    </div>
  </div>
</div>

<script>
  import { SHOW_SPLASH } from "astro:env/client";
  import { animate } from "motion";

  const heroImage = document.querySelector("#hero-image");

  window.addEventListener("load", async () => {
    await animate(
      heroImage,
      {
        opacity: [0, 100],
        x: [30, 0],
        y: [30, 0],
        rotate: [20, 3],
      },
      {
        delay: SHOW_SPLASH ? 1.5 : 0,
        type: "spring",
        bounce: 0.5,
      },
    );

    animate(
      heroImage,
      {
        y: [0, 10, 0],
        rotate: [3, 0, 3],
      },
      {
        duration: 5,
        ease: "easeOut",
        repeat: Infinity,
      },
    );
  });

  const discoverItems = document.querySelectorAll(".discover-item");

  discoverItems.forEach((dItem) => {
    // mouse enter
    dItem?.addEventListener("mouseenter", async () => {
      const img1 = dItem.querySelector(".img-1");
      const img2 = dItem.querySelector(".img-2");

      animate(
        img1,
        {
          rotate: [0, -10],
          x: [0, -10],
          y: [0, 5],
        },
        {
          type: "spring",
        },
      );

      await animate(
        img2,
        {
          rotate: [0, 5],
          y: [0, -5],
          x: [0, 10],
          scale: 1.1,
        },
        {
          type: "spring",
        },
      );
    });

    // mouse leave
    dItem?.addEventListener("mouseleave", async () => {
      const img1 = dItem.querySelector(".img-1");
      const img2 = dItem.querySelector(".img-2");

      animate(img1, {
        rotate: [-10, 0],
        y: [5, 0],
        x: [-10, 0],
      });

      await animate(img2, {
        rotate: [5, 0],
        y: [-5, 0],
        x: [10, 0],
        scale: 1,
      });
    });
  });
</script>
