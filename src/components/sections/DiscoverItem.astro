---
type Props = {
  imgSrc: string;
  title: string;
  description: string;
  isLast?: boolean;
};

const props = Astro.props;
---

<div
  class={`flex flex-col justify-center items-center text-center ${!props.isLast && "dashed-gradient-right"} `}
>
  <!-- Band aid solution to larger image size -->
  <img class={`${!props.isLast ? "w-[50%]" : "w-[40%]"}`} src={props.imgSrc} />
  <h2 class="text-secondary font-semibold text-2xl mt-4">{props.title}</h2>
  <p class="font-light w-[80%] text-accent text-sm">{props.description}</p>
</div>
