---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Banner from "../components/Banner.astro";
import Header from "../components/Header.astro";
import SplashScreen from "../components/SplashScreen.astro";
import DiscoverSection from "../components/sections/DiscoverSection.astro";
import BrandIdentity from "../components/sections/BrandIdentity.astro";
import { SHOW_SPLASH } from "astro:env/client";
---

<Layout>
  <Banner />
  <Header />
  <Hero />
  <DiscoverSection />
  <BrandIdentity />

  {SHOW_SPLASH && <SplashScreen />}
</Layout>
